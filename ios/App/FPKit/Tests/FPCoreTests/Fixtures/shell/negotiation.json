      "base": ["coach", "coachHome", "tabs"], "os": 27, "root": "tabs", "hello": { "v": 2, "screens": ["coachHome", "coach", "tabs"] },
      "want": { "v": 1, "why": null, "screens": ["coach", "coachHome", "tabs"], "tabs": true, "declined": [], "fellBack": null, "needs": {} }
    },
    {
      "case": "tab root: a screen this binary lacks is ignored",
      "base": ["coach", "coachHome", "tabs"], "os": 27, "root": "tabs", "hello": { "v": 1, "screens": ["coachHome", "coach", "tabs", "settings"] },
      "want": { "v": 1, "why": null, "screens": ["coach", "coachHome", "tabs"], "tabs": true, "declined": [], "fellBack": null, "needs": {} }
    },
    {
      "case": "tab root, the Coach tab off by its own checks: the chat goes with it (joint)",
      "base": ["coach", "tabs"], "os": 27, "root": "tabs", "hello": { "v": 1, "screens": ["coachHome", "coach", "tabs"] },
      "want": { "v": 1, "why": null, "screens": ["tabs"], "tabs": true, "declined": [], "fellBack": null, "needs": { "coach": ["coachHome"] } }
    },
    {
