  "cascade": [
    {
      "case": "tab root: tabs trips; coach and coachHome follow by dependency, then the fallback",
      "root": "tabs", "live": ["coach", "coachHome", "tabs"], "event": { "trip": "tabs" },
      "want": { "off": [{ "screen": "coach", "why": "needs", "needs": ["coachHome"] }, { "screen": "coachHome", "why": "needs", "needs": ["tabs"] }, { "screen": "tabs", "why": "failures" }], "trips": ["tabs"], "fellBack": "failures" }
    },
    {
