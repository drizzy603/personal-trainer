      "want": { "v": 1, "why": null, "screens": ["coach"], "tabs": false, "declined": [], "fellBack": null, "needs": { "coachHome": ["tabs"], "tabs": ["root"] } }
    },
    {
      "case": "a classic root: a page naming all three gets coach alone, nothing declined",
      "base": ["coach", "coachHome", "tabs"], "os": 27, "root": "classic", "hello": { "v": 1, "screens": ["coachHome", "coach", "tabs"] },
      "want": { "v": 1, "why": null, "screens": ["coach"], "tabs": false, "declined": [], "fellBack": null, "needs": { "coachHome": ["tabs"], "tabs": ["root"] } }
