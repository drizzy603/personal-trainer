      "base": ["coach", "coachHome", "tabs"], "os": 27, "root": "tabs", "hello": { "v": 1, "screens": ["coachHome", "tabs"] },
      "want": { "v": 1, "why": null, "screens": ["tabs"], "tabs": true, "declined": [], "fellBack": null, "needs": {} }
    },
